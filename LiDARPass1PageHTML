<title>P.A.R. Lidar Scan — Pass 1</title>
<style>
  :root {
    --paper: #fafaf8; --ink: #1f2523; --muted: #68716e; --line: #dde2e0;
    --chip: #f0f2f1; --tip-bg: #222826; --tip-ink: #f2f4f3; --spark: #3a4744;
  }
  @media (prefers-color-scheme: dark) {
    :root { --paper: #171b1a; --ink: #e6eae8; --muted: #8f9995; --line: #2c3331;
            --chip: #212725; --tip-bg: #f2f4f3; --tip-ink: #222826; --spark: #aab6b2; }
  }
  :root[data-theme="dark"] { --paper: #171b1a; --ink: #e6eae8; --muted: #8f9995; --line: #2c3331;
                             --chip: #212725; --tip-bg: #f2f4f3; --tip-ink: #222826; --spark: #aab6b2; }
  :root[data-theme="light"] { --paper: #fafaf8; --ink: #1f2523; --muted: #68716e; --line: #dde2e0;
                              --chip: #f0f2f1; --tip-bg: #222826; --tip-ink: #f2f4f3; --spark: #3a4744; }

  html, body { background: var(--paper); color: var(--ink); }
  body { font-family: system-ui, -apple-system, sans-serif; margin: 0; padding: 28px 32px 56px; }
  .mono { font-family: ui-monospace, "SF Mono", Menlo, monospace; font-variant-numeric: tabular-nums; }

  header { display: flex; flex-wrap: wrap; align-items: baseline; gap: 10px 18px; }
  h1 { font-size: 19px; font-weight: 650; margin: 0; letter-spacing: -0.01em; }
  h2 { font-size: 15px; font-weight: 650; margin: 40px 0 4px; }
  .sub { color: var(--muted); font-size: 13px; }

  .chips { display: flex; flex-wrap: wrap; gap: 8px; margin: 14px 0 18px; }
  .chip { background: var(--chip); border-radius: 6px; padding: 7px 12px; font-size: 12px; color: var(--muted); }
  .chip b { color: var(--ink); font-weight: 600; font-size: 13px; margin-right: 2px; }

  .legend { display: flex; align-items: center; gap: 10px; margin: 0 0 16px; font-size: 11.5px; color: var(--muted); }
  .legend .bar { width: 220px; height: 12px; border-radius: 3px; border: 1px solid var(--line); }
  .legend .lab { letter-spacing: 0.02em; text-transform: uppercase; font-size: 10.5px; }

  .scroller { overflow-x: auto; padding-bottom: 8px; }
  .gridwrap { display: inline-grid; grid-template-columns: 34px repeat(37, 30px); gap: 2px; }
  .hcell, .vcell { font-size: 9.5px; color: var(--muted); display: flex; align-items: center; justify-content: center; }
  .vcell { justify-content: flex-end; padding-right: 8px; }
  .cell { height: 26px; border-radius: 3px; display: flex; align-items: center; justify-content: center;
          font-size: 10.5px; cursor: default; }
  .cell.small { font-size: 9px; }
  .cell:hover { outline: 2px solid var(--ink); outline-offset: 0; position: relative; z-index: 2; }
  .sparkrow { display: inline-grid; grid-template-columns: 34px repeat(37, 30px); gap: 2px; margin-top: 6px; }
  .sparkrow svg { display: block; }
  .sparklab { font-size: 9.5px; color: var(--muted); display: flex; align-items: flex-start; justify-content: flex-end; padding: 2px 8px 0 0; }

  #tip { position: fixed; pointer-events: none; background: var(--tip-bg); color: var(--tip-ink);
         border-radius: 6px; padding: 8px 11px; font-size: 12px; line-height: 1.55; display: none;
         box-shadow: 0 3px 14px rgba(0,0,0,0.25); z-index: 10; }
  #tip b { font-weight: 650; }
  #tip .dim { opacity: 0.65; }

  .note { margin-top: 14px; font-size: 12.5px; color: var(--muted); max-width: 68ch; line-height: 1.6; }
</style>

