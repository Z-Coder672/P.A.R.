"resid":[-0.498,0.413,0.324,0.424,-0.853,0.058,0.969,0.88,-0.209,-0.298,-1.198,0.524,-0.565,-0.465,-0.743,-0.832,0.079,1.99],"coef":[37.4977,1.5121]},"pin-sine":{"rms":0.7533477674995019,"fit":[37.802,37.797,37.796,37.802,37.816,37.842,37.881,37.937,38.008,38.097,38.203,38.326,38.464,38.616,38.78,38.953,39.132,39.314],"resid":[-0.802,0.203,0.204,0.387,-0.816,0.158,1.119,1.063,-0.008,-0.097,-1.014,0.674,-0.464,-0.427,-0.78,-0.953,-0.132,1.686],"coef":[37.8016,1.5121,-0.507]},"clamped":{"rms":0.7656591037719639,"fit":[37.63,37.709,37.771,37.819,37.859,37.896,37.939,37.993,38.064,38.153,38.26,38.384,38.519,38.659,38.798,38.928,39.044,39.142],"resid":[-0.63,0.291,0.229,0.37,-0.859,0.104,1.061,1.007,-0.064,-0.153,-1.071,0.616,-0.519,-0.47,-0.798,-0.928,-0.044,1.858],"coef":[37.6299,1.5121,-0.14]},"cubic":{"rms":0.6010364479041881,"fit":[37.001,37.564,37.956,38.202,38.325,38.352,38.308,38.216,38.102,37.992,37.909,37.88,37.928,38.079,38.357,38.789,39.397,40.209],"resid":[-0.001,0.436,0.044,-0.013,-1.325,-0.352,0.692,0.784,-0.102,0.008,-0.72,1.12,0.072,0.11,-0.357,-0.789,-0.397,0.791],"coef":[37.0009,11.1788,-28.3892,20.4182]}},"36":{"linear":{"rms":0.5451780238998799,"fit":[37.281,37.38,37.48,37.579,37.678,37.778,37.877,37.977,38.076,38.176,38.275,38.375,38.474,38.574,38.673,38.772,38.872,38.971],"resid":[-1.092,-0.191,0.709,0.61,0.322,0.222,0.123,0.023,0.113,0.013,-0.086,-1.375,0.715,-0.385,-0.484,0.417,0.317,0.029],"coef":[37.2806,1.6908]},"pin-sine":{"rms":0.5446451919032186,"fit":[37.238,37.35,37.462,37.574,37.684,37.792,37.899,38.003,38.105,38.204,38.301,38.396,38.488,38.579,38.668,38.755,38.842,38.928],"resid":[-1.049,-0.161,0.727,0.615,0.316,0.208,0.101,-0.003,0.084,-0.015,-0.112,-1.396,0.701,-0.39,-0.479,0.434,0.347,0.072],"coef":[37.2376,1.6908,0.0718]},"clamped":{"rms":0.5444597963123011,"fit":[37.317,37.414,37.506,37.594,37.68,37.765,37.852,37.942,38.036,38.136,38.24,38.349,38.461,38.575,38.688,38.799,38.906,39.008],"resid":[-1.128,-0.225,0.683,0.595,0.32,0.235,0.148,0.058,0.153,0.053,-0.051,-1.349,0.728,-0.386,-0.499,0.39,0.283,-0.008],"coef":[37.3171,1.6908,-0.0386]},"cubic":{"rms":0.4568943789195948,"fit":[36.652,37.17,37.562,37.845,38.034,38.145,38.197,38.204,38.183,38.151,38.125,38.119,38.152,38.239,38.397,38.642,38.991,39.459],"resid":[-0.463,0.019,0.627,0.344,-0.034,-0.145,-0.197,-0.204,0.006,0.038,0.064,-1.119,1.037,-0.05,-0.208,0.547,0.198,-0.459],"coef":[36.6519,9.9788,-20.6163,13.4448]}}}</script>
<script>
  // rows: [y, x, avgCorrected, n, min, max, backIsBlack(1/0), clear, avgRaw]
  // avgCorrected = avgRaw + 0.19 on black-back cells — the refit back-color
  // offset derived from per-row black-vs-cyan means (see note).
  const rows = JSON.parse(document.getElementById('data').textContent);
  const fits = JSON.parse(document.getElementById('fits').textContent);
  const W = 37, H = 18;
  const avgs = rows.map(r => r[2]);
  const mean = avgs.reduce((a, b) => a + b, 0) / avgs.length;
  const sd = Math.sqrt(avgs.reduce((a, b) => a + (b - mean) ** 2, 0) / (avgs.length - 1));
  const lo = Math.min(...avgs), hi = Math.max(...avgs);
  const span = Math.max(mean - lo, hi - mean) || 1;

  const GREEN = [16, 90, 45], RED = [140, 25, 28], WHITE = [255, 255, 255];
  function mix(a, b, t) { return a.map((v, i) => Math.round(v + (b[i] - v) * t)); }
  function rampColor(dev, sp) {
    const t = Math.min(Math.abs(dev) / sp, 1);
    return mix(WHITE, dev >= 0 ? GREEN : RED, Math.pow(t, 0.85));
  }
  function css(c) { return `rgb(${c[0]},${c[1]},${c[2]})`; }
  function inkFor(c) {
    const l = (0.2126 * c[0] + 0.7152 * c[1] + 0.0722 * c[2]) / 255;
    return l > 0.55 ? '#1f2523' : '#f5f7f6';
  }
  function gradient(el, sp) {
    const stops = [];
    for (let i = 0; i <= 10; i++) {
      const dev = -sp + (2 * sp * i) / 10;
      stops.push(`${css(rampColor(dev, sp))} ${i * 10}%`);
    }
    el.style.background = `linear-gradient(90deg, ${stops.join(',')})`;
  }

  // ---- precision: vertical-adjacent pairs ----
  const byPos = {};
  rows.forEach(r => { byPos[r[0] * W + r[1]] = r; });
  const diffs = [];
  for (let y = 0; y < H - 1; y++)
    for (let x = 0; x < W; x++)
      diffs.push(byPos[(y + 1) * W + x][2] - byPos[y * W + x][2]);
  const dmean = diffs.reduce((a, b) => a + b, 0) / diffs.length;
  const dsd = Math.sqrt(diffs.reduce((a, b) => a + (b - dmean) ** 2, 0) / (diffs.length - 1));
  const sorted = [...diffs].sort((a, b) => a - b);
  const med = sorted[Math.floor(sorted.length / 2)];
  const absdev = diffs.map(v => Math.abs(v - med)).sort((a, b) => a - b);
  const dmad = absdev[Math.floor(absdev.length / 2)];
  const cellSigma = dsd / Math.SQRT2;

  document.getElementById('chips').innerHTML =
    `<span class="chip"><b>${mean.toFixed(2)} mm</b> board mean</span>` +
    `<span class="chip"><b>${lo.toFixed(1)}–${hi.toFixed(1)} mm</b> range</span>` +
    `<span class="chip"><b>±${sd.toFixed(2)} mm</b> σ</span>` +
    `<span class="chip"><b>${rows.length}</b> cells · 0 timeouts</span>` +
    `<span class="chip"><b>${dsd.toFixed(2)} mm</b> vertical-pair SD (n=${diffs.length})</span>` +
    `<span class="chip"><b>${dmad.toFixed(2)} mm</b> vertical-pair MAD</span>` +
    `<span class="chip"><b>${cellSigma.toFixed(2)} mm</b> implied per-cell σ</span>` +
    `<span class="chip"><b>−12.81 / −20</b> refit back offsets (was −13 / −20)</span>`;

  gradient(document.getElementById('legendbar'), span);
  document.getElementById('legendrange').textContent = `−${span.toFixed(1)} … +${span.toFixed(1)} mm vs mean`;

  const grid = document.getElementById('grid');
  const tip = document.getElementById('tip');
  let out = '<div class="vcell"></div>';
  for (let x = 0; x < W; x++) out += `<div class="hcell">${x}</div>`;
  for (let y = 0; y < H; y++) {
    out += `<div class="vcell">${y}</div>`;
    for (let x = 0; x < W; x++) {
      const r = byPos[y * W + x];
      const c = rampColor(r[2] - mean, span);
      out += `<div class="cell small" data-i="${y * W + x}" data-kind="d" style="background:${css(c)};color:${inkFor(c)}">${r[2].toFixed(1)}</div>`;
    }
  }
  grid.innerHTML = out;

  // ---- rod-bend section ----
  const ROD = 'pin-sine';  // the end-loaded model; 'linear' and 'cubic' kept for reference
  const rodOf = x => fits[x][ROD];
  const rmsLin = [], rmsRod = [], rmsCub = [];
  for (let x = 0; x < W; x++) {
    rmsLin.push(fits[x].linear.rms); rmsRod.push(rodOf(x).rms); rmsCub.push(fits[x].cubic.rms);
  }
  const median = a => { const s = [...a].sort((p, q) => p - q); return s[Math.floor(s.length / 2)]; };
  const allResid = [];
  for (let x = 0; x < W; x++) allResid.push(...rodOf(x).resid);
  const rmean = allResid.reduce((a, b) => a + b, 0) / allResid.length;
  const rsd = Math.sqrt(allResid.reduce((a, b) => a + (b - rmean) ** 2, 0) / (allResid.length - 1));
  const rspan = Math.max(...allResid.map(Math.abs));

  document.getElementById('rodchips').innerHTML =
    `<span class="chip"><b>${median(rmsLin).toFixed(2)} mm</b> median column RMS, straight rod</span>` +
    `<span class="chip"><b>${median(rmsRod).toFixed(2)} mm</b> median column RMS, line + half-sine</span>` +
    `<span class="chip"><b>${median(rmsCub).toFixed(2)} mm</b> free cubic (reference)</span>` +
    `<span class="chip"><b>${rsd.toFixed(2)} mm</b> model residual σ (all 666)</span>` +
    `<span class="chip"><b>${cellSigma.toFixed(2)} mm</b> sensor noise floor</span>`;
  document.getElementById('residsd').textContent = `σ ${rsd.toFixed(2)} mm`;
  document.getElementById('noisefloor').textContent = `${cellSigma.toFixed(2)} mm`;

  gradient(document.getElementById('legendbar2'), rspan);
  document.getElementById('legendrange2').textContent = `−${rspan.toFixed(1)} … +${rspan.toFixed(1)} mm residual`;

  const rg = document.getElementById('residgrid');
  out = '<div class="vcell"></div>';
  for (let x = 0; x < W; x++) out += `<div class="hcell">${x}</div>`;
  for (let y = 0; y < H; y++) {
    out += `<div class="vcell">${y}</div>`;
    for (let x = 0; x < W; x++) {
      const v = rodOf(x).resid[y];
      const c = rampColor(v, rspan);
      out += `<div class="cell small" data-i="${y * W + x}" data-kind="r" style="background:${css(c)};color:${inkFor(c)}">${v > 0 ? '+' : ''}${v.toFixed(1)}</div>`;
    }
  }
  rg.innerHTML = out;

  // ---- per-column rod profiles (small multiples) ----
  const colVals = [];
  let devMax = 0;
  for (let x = 0; x < W; x++) {
    const v = []; let m = 0;
    for (let y = 0; y < H; y++) { v.push(byPos[y * W + x][2]); m += byPos[y * W + x][2]; }
    m /= H;
    colVals.push({ v, m });
    for (let y = 0; y < H; y++) {
      devMax = Math.max(devMax, Math.abs(v[y] - m), Math.abs(rodOf(x).fit[y] - m));
    }
  }
  const SW = 30, SH = 120;
  const sx = dev => SW / 2 + (dev / devMax) * (SW / 2 - 3);
  const sy = y => 6 + (y / (H - 1)) * (SH - 12);
  let sp = `<div class="sparklab">rod<br>fit</div>`;
  for (let x = 0; x < W; x++) {
    const { v, m } = colVals[x];
    let path = '';
    for (let y = 0; y < H; y++) path += `${y ? 'L' : 'M'}${sx(rodOf(x).fit[y] - m).toFixed(1)},${sy(y).toFixed(1)}`;
    let dots = '';
    for (let y = 0; y < H; y++)
      dots += `<circle cx="${sx(v[y] - m).toFixed(1)}" cy="${sy(y).toFixed(1)}" r="1.6" fill="var(--spark)"/>`;
    sp += `<svg width="${SW}" height="${SH}" viewBox="0 0 ${SW} ${SH}">` +
          `<line x1="${SW / 2}" y1="4" x2="${SW / 2}" y2="${SH - 4}" stroke="var(--line)" stroke-width="1"/>` +
          `<path d="${path}" fill="none" stroke="var(--spark)" stroke-width="1.4" opacity="0.55"/>` + dots + `</svg>`;
  }
  sp += `<div class="sparklab">bow</div>`;
  for (let x = 0; x < W; x++) {
    const A = rodOf(x).coef[2];
    sp += `<div class="hcell" style="font-size:8.5px">${A > 0 ? '+' : ''}${A.toFixed(1)}</div>`;
  }
  document.getElementById('sparks').innerHTML = sp;

  // ---- shared tooltip ----
  function showTip(e) {
    const el = e.target.closest('.cell');
    if (!el || el.dataset.i === undefined) { tip.style.display = 'none'; return; }
    const i = +el.dataset.i, r = byPos[i];
    const y = r[0], x = r[1];
    const fit = rodOf(x).fit[y], resid = rodOf(x).resid[y];
    if (el.dataset.kind === 'd') {
      const dev = r[2] - mean;
      tip.innerHTML =
        `<b>y=${y} x=${x}</b> &nbsp;${r[2].toFixed(2)} mm <span class="dim">(${dev >= 0 ? '+' : ''}${dev.toFixed(2)} vs mean · raw ${r[8]})</span><br>` +
        `n=${r[3]} &nbsp; window ${r[4]}–${r[5]} mm<br>` +
        `<span class="dim">back=${r[6] ? 'black (−12.81 refit)' : 'cyan (−20)'} · clear=${r[7]}</span>`;
    } else {
      tip.innerHTML =
        `<b>y=${y} x=${x}</b> &nbsp;residual ${resid > 0 ? '+' : ''}${resid.toFixed(2)} mm<br>` +
        `measured ${r[2].toFixed(2)} mm · rod fit ${fit.toFixed(2)} mm · bow ${rodOf(x).coef[2].toFixed(1)}<br>` +
        `<span class="dim">column RMS: line+sine ${rodOf(x).rms.toFixed(2)} · straight ${fits[x].linear.rms.toFixed(2)} mm</span>`;
    }
    tip.style.display = 'block';
    const pad = 14;
    let tx = e.clientX + pad, ty = e.clientY + pad;
    const bb = tip.getBoundingClientRect();
    if (tx + bb.width > innerWidth - 8) tx = e.clientX - bb.width - pad;
    if (ty + bb.height > innerHeight - 8) ty = e.clientY - bb.height - pad;
    tip.style.left = tx + 'px'; tip.style.top = ty + 'px';
  }
  grid.addEventListener('mousemove', showTip);
  rg.addEventListener('mousemove', showTip);
  grid.addEventListener('mouseleave', () => { tip.style.display = 'none'; });
  rg.addEventListener('mouseleave', () => { tip.style.display = 'none'; });
</script>

</body>