# --- Deny direct web access to secrets, data, and internal source ---------
# The frontend only ever talks to *.php endpoints (verified), so raw data files
# are never fetched by a browser and can be fully denied. Emails live encrypted
# ABOVE the document root (see lib/private_store.php); these rules are a second
# line of defense in case a file ever lands inside the served tree.
<FilesMatch "(^\.env$|^\.DS_Store$|^router\.php$|\.log$|\.flag$|\.enc$|^email\.key$|^queue\.txt$|^mod_queue\.txt$|^qr-visits\.txt$|^latest-video\.json$|^(pending|info)\.json$)">
    Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Block internal / private directories outright.
    RewriteRule ^locks(/|$)       - [F,L]
    RewriteRule ^lib(/|$)         - [F,L]
    RewriteRule ^par-private(/|$) - [F,L]

    # QR-code visits carry ?q=1 — count them, then serve the SPA. Only fire on
    # the SPA routes (not existing files/endpoints) so a stray ?q=1 on an asset
    # or PHP endpoint is ignored.
    RewriteCond %{QUERY_STRING} (^|&)q=1(&|$)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ qr-count.php [L]

    # If the requested URI is exactly /gallery or /gallery/, route to SPA
    RewriteRule ^gallery/?$ index.html [L]

    # If the requested file or directory exists, serve it as-is
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Otherwise, route all requests to index.html
    RewriteRule ^ index.html [L]
</IfModule>
