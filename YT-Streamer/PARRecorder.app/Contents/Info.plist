<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleIdentifier</key>
    <string>com.par.ytstreamer</string>
    <key>CFBundleName</key>
    <string>PARRecorder</string>
    <key>CFBundleDisplayName</key>
    <string>P.A.R. Recorder</string>
    <key>CFBundleExecutable</key>
    <string>parrecorder</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleVersion</key>
    <string>1.0</string>
    <key>CFBundleShortVersionString</key>
    <string>1.0</string>
    <!-- No Dock icon / not user-facing: it's a background recorder. -->
    <key>LSBackgroundOnly</key>
    <true/>
    <!-- REQUIRED for the camera consent prompt to appear for a non-Apple bundle.
         This string is what the one-time dialog shows. -->
    <key>NSCameraUsageDescription</key>
    <string>P.A.R. records the LED matrix on the camera during each print.</string>
</dict>
</plist>
